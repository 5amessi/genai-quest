# Runtime/provider selection. `local` is deterministic and credential-free.
APP_ENV=local
BACKEND=local
AUTH_MODE=demo
LOG_LEVEL=INFO

# Parsing, retrieval and grounding
MAX_CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=35
RETRIEVAL_TOP_K=8
MIN_RETRIEVAL_SCORE=0.24
MIN_EVIDENCE_COVERAGE=0.35
PROMPT_VERSION=grounded-answer-v1

# Timeouts/retries
LLM_TIMEOUT_SECONDS=12
SEARCH_TIMEOUT_SECONDS=3
EMBEDDING_TIMEOUT_SECONDS=5
RETRY_ATTEMPTS=3

# Cost estimation (USD per one million tokens; examples only, update from approved pricing)
MODEL_PRICE_INPUT_PER_MILLION=0.15
MODEL_PRICE_OUTPUT_PER_MILLION=0.60

# Azure AI Search (required when BACKEND=azure)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=knowledge-chunks-v1
AZURE_SEARCH_API_VERSION=2025-09-01

# Azure OpenAI (required when BACKEND=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Entra validation (AUTH_MODE=entra). Managed identity is used for Azure data planes.
AZURE_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=

# Observability. Application logs omit raw question/document content.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local/test-only failure injection. Must remain false outside local/test.
ALLOW_FAILURE_INJECTION=false
